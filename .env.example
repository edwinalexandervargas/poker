# Copy this file to .env.production.local and fill it in with your Firebase web app settings
# (Firebase console > Project settings > Your apps). That file is ignored by git.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=

# Optional: Firebase App Check. A reCAPTCHA Enterprise site key for this domain. Leave empty to
# run without App Check. (See README: "Turning on App Check".)
VITE_APPCHECK_SITE_KEY=
